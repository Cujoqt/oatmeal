{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oatmeal",
  "version": "0.1.0",
  "identifier": "dev.oatmeal.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Oatmeal",
        "width": 940,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": null,
        "label": "main",
        "url": "index.html"
      },
      {
        "label": "transcript",
        "title": "Transcript",
        "url": "transcript.html",
        "width": 760,
        "height": 520,
        "minWidth": 420,
        "minHeight": 320,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "Local meeting recorder, invisible to screen sharing.",
    "longDescription": "Oatmeal records your meetings locally (mic + system audio), transcribes with on-device Whisper, and stays invisible to Discord/Zoom/Loom screen shares.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  }
}
