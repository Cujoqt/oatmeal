# ── dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── build output ─────────────────────────────────────────────────────────────
target/
app/src-tauri/target/
app/src-tauri/gen/
dist/
*.dmg

# ── local data: recordings, notes, config, logs ───────────────────────────────
# Meetings are the user's own audio and transcripts. They never belong in git.
meetings/*
!meetings/.gitkeep
oatmeal.config.json
.oatmeal-notified.json
*.log

# ── agent + tooling scratch, not part of the product ─────────────────────────
# This repository is public. Agent instructions and working notes are local
# tooling, not the product, and CLAUDE.md carried a personal Apple signing
# identity — so none of it belongs in a public history.
memory.md
CLAUDE.md
.claude/
docs/superpowers/
.gstack/
.gstack-*
.impeccable/
graphify-out/
*.vsix

# ── macOS + editor noise ─────────────────────────────────────────────────────
.DS_Store
Screenshot*.png
*.swp
.idea/
.vscode/
