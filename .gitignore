meetings/*
!meetings/.gitkeep
oatmeal.config.json
.oatmeal-notified.json
*.log

# ── agent + tooling scratch, not part of the product ─────────────────────────
memory.md
docs/superpowers/
.gstack/
.gstack-*
.impeccable/
.claude/skills/gstack/
.claude/worktrees/
graphify-out/
*.vsix

# ── macOS + editor noise ─────────────────────────────────────────────────────
.DS_Store
Screenshot*.png
*.swp
.idea/
.vscode/
