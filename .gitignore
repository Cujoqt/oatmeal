# ── dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── build output ─────────────────────────────────────────────────────────────
target/
app/src-tauri/target/
app/src-tauri/gen/
dist/
*.dmg

# ── local data: recordings, notes, config, logs ───────────────────────────────
